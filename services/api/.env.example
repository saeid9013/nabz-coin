# PowerShell environment variables or service configuration; .env is not auto-loaded.
APP_MODE=demo
DATABASE_PATH=nabz-demo.sqlite3
CMC_API_KEY=replace_on_server_only
MONTHLY_CREDIT_LIMIT=13000
EXTERNAL_CREDITS=0
HISTORY_CREDIT_LIMIT=2000
METADATA_CREDIT_LIMIT=500
CMC_METADATA_ENABLED=false
CMC_INDICES_ENABLED=false
CMC_HISTORY_IDS=
CMC_HISTORY_ACCESS_CONFIRMED=false
MARKET_INTERVAL_SECONDS=600
OVERVIEW_INTERVAL_SECONDS=1800
TRANSLATION_PROVIDER=disabled
TRANSLATION_API_KEY=replace_on_server_only
TRANSLATION_MODEL=choose_a_supported_model
# Set current prices for that exact model; zero disables activation.
TRANSLATION_INPUT_USD_PER_MILLION=0
TRANSLATION_OUTPUT_USD_PER_MILLION=0
TRANSLATION_DAILY_USD_LIMIT=0
TRANSLATION_DAILY_LIMIT=100
NEWS_FEED_URLS=
NEWS_ALLOWED_DOMAINS=
NEWS_LICENSE_CONFIRMED=false
